{
  "name": "battlelines",
  "version": "0.1.0",
  "private": true,
  "description": "Battle Lines: an email-driven, simultaneous-turn hex wargame (prototype).",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node --disable-warning=ExperimentalWarning --enable-source-maps dist/src/server/server.js",
    "dev": "npm run build && (tsc -p . --watch --preserveWatchOutput & DEV_TOOLS=1 node --disable-warning=ExperimentalWarning --enable-source-maps --watch dist/src/server/server.js)",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --enable-source-maps --test 'dist/test/*.test.js'"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^6.4.24",
    "typescript": "5.9"
  }
}
